# ====================================================================
# NEXUS CORE - Backend Environment Variables (EXEMPLO)
# ====================================================================
# Copie este arquivo para ".env" e preencha com seus valores reais:
#     cp .env.example .env
#
# OBS: O arquivo ".env" NAO deve ser versionado (esta no .gitignore).
#      Use este .env.example como modelo/documentacao.
# ====================================================================

# --- Banco de dados PostgreSQL (usado pelo docker-compose) ---
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/nexus

# --- Autenticacao / JWT ---
# Gere um valor forte com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBTITUA_POR_UM_SECRET_KEY_FORTE_DE_64_CARACTERES_HEXADECIMAIS

ALGORITHM=HS256

# Tempo de expiracao do token em minutos (padrao: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60
